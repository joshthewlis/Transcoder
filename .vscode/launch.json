{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Server + Worker",
      "configurations": [
        "Transcoder.Server",
        "Transcoder.Worker"
      ],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Transcoder.Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Transcoder.Server/bin/Debug/net10.0/Transcoder.Server.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Transcoder.Server",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (http://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      }
    },
    {
      "name": "Transcoder.Worker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Transcoder.Worker/bin/Debug/net10.0/Transcoder.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Transcoder.Worker",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ]
}
