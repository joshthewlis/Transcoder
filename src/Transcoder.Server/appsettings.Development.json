{
  "ConnectionStrings": {
    "Transcoder": "Data Source=transcoder-dev.db"
  },
  "Transcoder": {
    "ApiVersion": "1",
    "PollSeconds": 10,
    "Security": {
      "AdminApiKey": "dev-admin-key",
      "WorkerApiKey": "dev-worker-key"
    },
    "Storage": {
      "TranscoderRoot": "C:\\TransTest\\.transcoder",
      "WorkingRoot": "C:\\TransTest\\.transcoder\\working",
      "StagingRoot": "C:\\TransTest\\.transcoder\\staging",
      "AutoCreateStorageFolders": true
    },
    "WorkerRequirements": {
      "RejectWorkersWithMissingRequiredTools": true,
      "MinimumFfmpegVersion": null,
      "MinimumFfprobeVersion": null,
      "RequireFfmpegForTranscoderRole": true,
      "RequireFfprobeForProberRole": true,
      "RequireFfprobeForValidatorRole": true
    },
    "ActiveHours": {
      "Enabled": true,
      "TimeZoneId": "Europe/London",
      "Start": "08:30",
      "Stop": "02:00",
      "StopNewWorkMinutesBefore": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
