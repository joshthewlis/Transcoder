{
  "ConnectionStrings": {
    "Transcoder": "Data Source=/app/data/transcoder.db"
  },
  "Transcoder": {
    "ApiVersion": "1",
    "PollSeconds": 10,
    "Security": {
      "AdminApiKey": "dev-admin-key",
      "WorkerApiKey": "dev-worker-key"
    },
    "WorkerTiming": {
      "ExpectedHeartbeatSeconds": 30,
      "UnresponsiveAfterSeconds": 60,
      "LostAfterSeconds": 300,
      "MaxLeaseSeconds": 300
    },
    "Storage": {
      "TranscoderRoot": "/mnt/.transcoder",
      "WorkingRoot": "/mnt/.transcoder/working",
      "StagingRoot": "/mnt/.transcoder/staging",
      "AutoCreateStorageFolders": true
    },
    "WorkerRequirements": {
      "RejectWorkersWithMissingRequiredTools": true,
      "MinimumFfmpegVersion": null,
      "MinimumFfprobeVersion": null,
      "RequireFfmpegForTranscoderRole": true,
      "RequireFfprobeForProberRole": true,
      "RequireFfprobeForValidatorRole": true
    },
    "ActiveHours": {
      "Enabled": true,
      "TimeZoneId": "Europe/London",
      "Start": "08:30",
      "Stop": "02:00",
      "StopNewWorkMinutesBefore": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
