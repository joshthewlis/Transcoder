{
  "Transcoder": {
    "ServerUrl": "http://localhost:5000",
    "ApiKey": "dev-worker-key",
    "WorkerId": "windows-dev-worker",
    "WorkerName": "Windows Dev Worker",
    "Roles": "Prober, Transcoder, Validator",
    "FfmpegPath": "C:\\Tools\\ffmpeg\\bin\\ffmpeg.exe",
    "FfprobePath": "C:\\Tools\\ffmpeg\\bin\\ffprobe.exe",
    "StopIfRequiredToolsMissing": true,
    "LocalWorkingRoot": "C:\\TranscoderWorker",
    "AutoCreateLocalWorkingRoot": true,
    "KeepLocalJobFilesOnSuccess": false,
    "TranscodeWorkingMode": "LocalThenCopyToStaging",
    "Limits": {
      "MaxProbeJobs": 10,
      "MaxPlanReviewJobs": 10,
      "MaxCleanupJobs": 4,
      "MaxTranscodeJobs": 1,
      "MaxValidationJobs": 5
    },
    "PathMappings": [
      {
        "ServerPrefix": "C:\\TransTest",
        "WorkerPrefix": "C:\\TransTest"
      },
      {
        "ServerPrefix": "Y:\\Movies",
        "WorkerPrefix": "Y:\\Movies"
      }
    ],
    "Shutdown": {
      "AllowRemoteShutdownRequest": false,
      "AllowRemoteExitRequest": true,
      "ShutdownCommand": "shutdown /s /t 60 /c \"Transcoder work complete\"",
      "IdleSecondsBeforeAction": 30
    },
    "Transcoding": {
      "AllowCpuEncoding": true,
      "AllowGpuEncoding": true,
      "CpuEncoders": [
        "libx265",
        "libx264",
        "libsvtav1",
        "libaom-av1"
      ],
      "GpuEncoders": [
        "hevc_nvenc",
        "h264_nvenc",
        "av1_nvenc",
        "hevc_qsv",
        "h264_qsv",
        "av1_qsv",
        "hevc_vaapi",
        "h264_vaapi",
        "av1_vaapi",
        "hevc_amf",
        "h264_amf",
        "av1_amf",
        "hevc_videotoolbox",
        "h264_videotoolbox"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}