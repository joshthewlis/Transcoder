{
  "Transcoder": {
    "ServerUrl": "http://192.168.11.11:5001",
    "ApiKey": "dev-worker-key",
    "WorkerId": "work-laptop",
    "WorkerName": "Work Laptop Transcoder",
    "Roles": "Transcoder",
    "FfmpegPath": "C:\\Tools\\ffmpeg\\bin\\ffmpeg.exe",
    "FfprobePath": "C:\\Tools\\ffmpeg\\bin\\ffprobe.exe",
    "StopIfRequiredToolsMissing": true,
    "LocalWorkingRoot": "C:\\TranscoderWorker",
    "AutoCreateLocalWorkingRoot": true,
    "KeepLocalJobFilesOnSuccess": false,
    "TranscodeWorkingMode": "LocalThenCopyToStaging",
    "Limits": {
      "MaxProbeJobs": 10,
      "MaxPlanReviewJobs": 10,
      "MaxCleanupJobs": 5,
      "MaxTranscodeJobs": 2,
      "MaxValidationJobs": 5
    },
    "PathMappings": [
      {
        "ServerPrefix": "/mnt/media",
        "WorkerPrefix": "Y:\\"
      }
    ],
    "Shutdown": {
      "AllowRemoteShutdownRequest": false,
      "AllowRemoteExitRequest": true,
      "ShutdownCommand": "shutdown /s /t 60 /c \"Transcoder work complete\"",
      "IdleSecondsBeforeAction": 30
    },
    "SourceCopy": {
      "Enabled": true,
      "MaxConcurrentCopies": 1,
      "MaxBufferedLocalWorkItems": 4,
      "DeleteLocalSourceAfterFfmpeg": true
    },
    "StagingCopy": {
      "MaxConcurrentCopies": 1,
      "MaxBufferedLocalOutputs": 4
    },
    "Transcoding": {
      "AllowCpuEncoding": true,
      "AllowGpuEncoding": true,
      "CpuEncoders": [
        "libx265",
        "libx264",
        "libsvtav1",
        "libaom-av1"
      ],
      "GpuEncoders": [
        "hevc_nvenc",
        "h264_nvenc",
        "av1_nvenc",
        "hevc_qsv",
        "h264_qsv",
        "av1_qsv",
        "hevc_vaapi",
        "h264_vaapi",
        "av1_vaapi",
        "hevc_amf",
        "h264_amf",
        "av1_amf",
        "hevc_videotoolbox",
        "h264_videotoolbox"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Transcoder.Worker": "Trace"
    }
  }
}