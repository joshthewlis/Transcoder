{
  "Transcoder": {
    "ServerUrl": "http://localhost:5000",
    "ApiKey": "dev-worker-key",
    "WorkerId": "worker-1",
    "WorkerName": "Worker 1",
    "Roles": "Prober, Transcoder, Validator",
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "StopIfRequiredToolsMissing": true,
    "LocalWorkingRoot": "/work/transcoder",
    "AutoCreateLocalWorkingRoot": true,
    "KeepLocalJobFilesOnSuccess": false,
    "TranscodeWorkingMode": "LocalThenCopyToStaging",
    "Limits": {
      "MaxProbeJobs": 10,
      "MaxPlanReviewJobs": 10,
      "MaxCleanupJobs": 4,
      "MaxTranscodeJobs": 1,
      "MaxValidationJobs": 5
    },
    "PathMappings": [
      {
        "ServerPrefix": "/mnt/movies",
        "WorkerPrefix": "/mnt/movies"
      },
      {
        "ServerPrefix": "/mnt/.transcoder",
        "WorkerPrefix": "/mnt/.transcoder"
      }
    ],
    "Shutdown": {
      "AllowRemoteShutdownRequest": false,
      "AllowRemoteExitRequest": true,
      "ShutdownCommand": null,
      "IdleSecondsBeforeAction": 30
    },
    "StagingCopy": {
      "MaxConcurrentCopies": 1,
      "MaxBufferedLocalOutputs": 4
    },
    "Transcoding": {
      "AllowCpuEncoding": true,
      "AllowGpuEncoding": true,
      "CpuEncoders": [
        "libx265",
        "libx264",
        "libsvtav1",
        "libaom-av1"
      ],
      "GpuEncoders": [
        "hevc_nvenc",
        "h264_nvenc",
        "av1_nvenc",
        "hevc_qsv",
        "h264_qsv",
        "av1_qsv",
        "hevc_vaapi",
        "h264_vaapi",
        "av1_vaapi",
        "hevc_amf",
        "h264_amf",
        "av1_amf",
        "hevc_videotoolbox",
        "h264_videotoolbox"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}